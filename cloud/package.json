{
  "name": "kielbox-cloud",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "npm run migrate",
    "dev": "CLOUDFLARE_ENV=dev vite dev --host 127.0.0.1 --port 8787 --strictPort",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "migrate": "wrangler d1 migrations apply DB --local --env dev",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "aws4fetch": "1.0.20",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@cloudflare/vitest-plugin": "1.8.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.160.1"
  }
}
